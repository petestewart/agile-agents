{
  "name": "agile-agents",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "bun": ">=1.3.11"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:integration": "AGILE_LIVE= bun test packages/cli/src/run.e2e.test.ts packages/daemon/src/feed/feed.e2e.test.ts packages/daemon/src/feed/control-room.e2e.test.ts",
    "test:live": "AGILE_LIVE=1 bun test packages/daemon/src/em/live.test.ts packages/daemon/src/sandbox/live.test.ts packages/cli/src/run.e2e.test.ts",
    "test:e2e": "bun test packages/daemon/src/feed/feed.e2e.test.ts packages/daemon/src/feed/control-room.e2e.test.ts",
    "e2e": "bun test packages/cli/src/run.e2e.test.ts",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.4.2",
    "playwright-core": "1.56.0",
    "typescript": "^5.7.2"
  }
}
